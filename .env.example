PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# Leave unset for manual drafting. Install Ollama and pull qwen2.5vl:7b to enable vision.
AI_PROVIDER=manual
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# Run npm start: a random reviewer setup code is printed if this is unset.
# Set a long random value on a hosted backend, and share only with your reviewers.
# REVIEWER_SETUP_CODE=
# Comma-separated exact origins; add your deployed website when hosting separately.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost

