PORT=3000
HOST=127.0.0.1
DATA_DIR=./data
# npm start uses manual drafting by default. npm run start:ai starts the pretrained damage model and API together.
AI_PROVIDER=manual
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5vl:7b
# Run npm start: a random reviewer setup code is printed if this is unset.
# Set a long random value on a hosted backend, and share only with your reviewers.
# REVIEWER_SETUP_CODE=
# Comma-separated exact origins; add your deployed website when hosting separately.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://localhost
# For a hosted service, add its exact public HTTPS origin:
# PUBLIC_ORIGIN=https://your-backend.example.com
# If Python is outside .venv-ai, set its executable path:
# AI_PYTHON=C:/path/to/python.exe

# Optional local assessment, testimony and report roles (Ollama must be running):
TEXT_AI_ENABLED=false
TEXT_AI_URL=http://127.0.0.1:11434
TEXT_AI_MODEL=qwen3.5:9b
TEXT_AI_TIMEOUT_MS=240000
DAMAGE_AI_THREADS=2
