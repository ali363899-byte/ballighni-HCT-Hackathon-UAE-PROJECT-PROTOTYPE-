{
  "name": "ballighni",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env backend/server.mjs",
    "start:ai": "node --env-file-if-exists=.env scripts/start-with-ai.mjs",
    "preview:phone": "node scripts/preview-phone.mjs",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "dev": "node --watch --env-file-if-exists=.env backend/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/build.mjs",
    "android:add": "npm run build && cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "start:shared": "node --env-file-if-exists=.env scripts/start-shared.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/core": "8.6.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "prettier": "3.6.2"
  },
  "overrides": {
    "glob": "14.0.2",
    "minimatch": "11.0.1"
  }
}
