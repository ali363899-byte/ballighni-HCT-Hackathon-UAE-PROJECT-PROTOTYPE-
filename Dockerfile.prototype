# Full prototype: website + persistent API + local CPU damage inference.
FROM node:24-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv libgl1 libglib2.0-0 gosu && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN python3 -m venv /opt/ai
COPY ai/requirements.txt ./ai/requirements.txt
RUN /opt/ai/bin/pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu && /opt/ai/bin/pip install --no-cache-dir -r ai/requirements.txt
COPY package*.json ./
RUN npm ci --omit=dev
COPY frontend ./frontend
COPY backend ./backend
COPY scripts ./scripts
COPY ai ./ai
RUN node scripts/download-model.mjs && node scripts/build.mjs && mkdir -p /app/data && chown -R node:node /app && chmod +x scripts/container-entrypoint.sh
ENV HOST=0.0.0.0 PORT=7860 DATA_DIR=/app/data AI_PYTHON=/opt/ai/bin/python
# Initialize the attached volume, then drop to the unprivileged app user.
ENTRYPOINT ["/app/scripts/container-entrypoint.sh"]
EXPOSE 7860
CMD ["node","scripts/start-with-ai.mjs"]
